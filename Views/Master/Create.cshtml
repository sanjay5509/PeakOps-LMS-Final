@using System.Reflection
@model object

@{
    ViewData["Title"] = "Add " + ViewBag.TableName;
    var properties = Model.GetType().GetProperties();
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Add New @ViewBag.TableName</h5>
    </div>
    <div class="card-body">

        <form asp-action="Create" asp-route-tableName="@ViewBag.TableName" method="POST">

            @foreach (var prop in properties)
            {
              
                if (prop.Name == "Id" || prop.Name == "CreatedOn" || prop.Name == "ModifiedOn")
                {
                    continue;
                }

              
                if (prop.PropertyType == typeof(bool))
                {
                    <div class="mb-3">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="@prop.Name" name="@prop.Name" value="true" checked />
                            <label class="form-check-label" for="@prop.Name">@prop.Name</label>
                        </div>
                    </div>
                }
               
                else
                {
                    <div class="mb-3">
                        <label class="form-label" for="@prop.Name">@prop.Name</label>

                        @if (prop.PropertyType == typeof(int))
                        {
                            <input type="number" class="form-control" id="@prop.Name" name="@prop.Name" required />
                        }
                        else
                        {
                            <input type="text" class="form-control" id="@prop.Name" name="@prop.Name" required />
                        }
                    </div>
                }
            }

            <button type="submit" class="btn btn-primary">Save Data</button>
            <a href="@Url.Action("Index", new { tableName = ViewBag.TableName })" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>