@model PeakOps.Core.Entities.Ticket

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold py-3 mb-0 text-primary">Ticket: #@Model.Id</h4>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card mb-4 border-top border-primary border-3">
                <div class="card-body">
                    <p><strong>Subject:</strong> @Model.Title</p>
                    <p><strong>Project:</strong> <span class="badge bg-label-info">@Model.Project?.ProjectName</span></p>
                    <p><strong>Status:</strong> <span class="badge bg-label-success">@Model.TicketStatus?.StatusName</span></p>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm">
                <h5 class="card-header border-bottom">Communication History</h5>
                <div class="card-body pt-4">
                    <form asp-action="AddComment" method="post" class="mb-4">
                        <input type="hidden" name="TicketId" value="@Model.Id" />

                        <div class="d-flex align-items-start gap-3">
                            <div class="flex-grow-1">
                                <textarea name="CommentText"
                                          class="form-control border-2 shadow-none"
                                          placeholder="Reply here..."
                                          rows="2"
                                          style="border-radius: 0.5rem;"
                                          required></textarea>
                            </div>

                            <button class="btn btn-primary d-flex align-items-center py-2 px-4 shadow-sm"
                                    type="submit"
                                    style="height: 45px; margin-top: 2px;">
                                <i class="bx bx-paper-plane me-1"></i> Send
                            </button>
                        </div>
                    </form>

                    <div class="comment-list">
                        @if (Model.Comments != null)
                        {
                            foreach (var c in Model.Comments)
                            {
                                <div class="p-3 mb-2 border rounded bg-lighter shadow-sm" id="comment-@c.Id">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="fw-bold text-primary">@(c.User?.FirstName ?? "System")</span>
                                        <div>
                                            <small class="text-muted me-2">@c.CreatedOn.ToString("dd MMM, hh:mm tt")</small>

                                            <button class="btn btn-sm btn-icon text-muted" onclick="enableEdit(@c.Id)" title="Edit">
                                                <i class="bx bx-edit-alt"></i>
                                            </button>

                                            <button class="btn btn-sm btn-icon text-danger" onclick="deleteComment(@c.Id)" title="Delete">
                                                <i class="bx bx-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <p class="mb-0 comment-content">@c.Description</p>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteComment(id) {
           
            Swal.fire({
                title: 'Bhai, pakka delete karna hai?',
                text: "Ek baar gaya toh wapis nahi aayega!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#696cff', 
                cancelButtonColor: '#8592a3', 
                confirmButtonText: 'Haan, uda do!',
                cancelButtonText: 'Nahi, rehne do'
            }).then((result) => {
                if (result.isConfirmed) {
                  
                    $.ajax({
                        url: '/Support/DeleteComment',
                        type: 'POST',
                        data: { CommentId: id },
                        success: function (res) {
                            if (res.success) {
                                
                                $('#comment-' + id).fadeOut(500, function () {
                                    $(this).remove();
                                });

                                
                                Swal.fire(
                                    'Deleted!',
                                    'Bhai, comment delete ho gaya.',
                                    'success'
                                );
                            } else {
                                Swal.fire('Error!', res.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error!', 'Bhai, server se connection toot gaya.', 'error');
                        }
                    });
                }
            });
        }
    </script>

}