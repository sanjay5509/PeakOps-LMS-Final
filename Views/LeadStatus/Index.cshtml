@model IEnumerable<PeakOps.Core.Entities.MasterData.LeadStatus>

@{
    ViewData["Title"] = "Lead Statuses";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5>Lead Statuses</h5>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bx bx-plus me-1"></i> Add New Status
        </a>
    </div>

    <div class="table-responsive text-nowrap">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Status Name</th>
                    <th>Display Order</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.StatusName</strong></td>
                        <td>@item.DisplayOrder</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-label-success me-1">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-label-danger me-1">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="dropdown">
                                <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                    <i class="bx bx-dots-vertical-rounded"></i>
                                </button>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id">
                                        <i class="bx bx-edit-alt me-1"></i> Edit
                                    </a>

                                    <a class="dropdown-item" asp-action="Delete" asp-route-id="@item.Id" onclick="return confirm('Are you sure you want to delete this status?');">
                                        <i class="bx bx-trash me-1"></i> Delete
                                    </a>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>