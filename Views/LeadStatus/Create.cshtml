@model PeakOps.Core.ViewModels.MasterData.LeadStatusViewModel

@{
    ViewData["Title"] = "Add Lead Status";
}   

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Add New Status</h5>
      
    </div>
    <div class="card-body"> 
        <form asp-action="Create" method="POST">

            <div class="mb-3">
                <label class="form-label" for="basic-default-fullname">Status Name</label>
                <input type="text" class="form-control" asp-for="StatusName" placeholder="e.g. Dead Lead" required />
                <span asp-validation-for="StatusName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" for="basic-default-company">Display Order</label>
                <input type="number" class="form-control" asp-for="DisplayOrder" placeholder="e.g. 6" />
                <div class="form-text">Dropdown mein kis number par dikhega?</div>
            </div>

            <div class="mb-3">
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" asp-for="IsActive" checked />
                    <label class="form-check-label" for="IsActive">Is Active?</label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Save Status</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>