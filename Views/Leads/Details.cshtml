@model PeakOps.Core.Entities.Lead

@{
    ViewData["Title"] = "Lead Details";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold py-3 mb-0">
            <span class="text-muted fw-light">Leads /</span> Lead Details
        </h4>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary me-2">Back to List</a>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#followUpModal">
                <i class="bx bx-plus me-1"></i> Add Activity
            </button>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <small class="text-muted text-uppercase fw-bold">Contact Details</small>
                    <ul class="list-unstyled mt-3 mb-0">
                        <li class="mb-2"><span class="fw-bold me-2">Name:</span> @Model.ContactPerson</li>
                        <li class="mb-2"><span class="fw-bold me-2">Mobile:</span> @Model.Mobile</li>
                        <li class="mb-2"><span class="fw-bold me-2">Email:</span> @(Model.Email ?? "-")</li>
                        <li class="mb-2"><span class="fw-bold me-2">Company:</span> @(Model.BusinessName ?? "-")</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <small class="text-muted text-uppercase fw-bold">Current Status</small>
                    <div class="row mt-3">
                        <div class="col-6 mb-3">
                            <span class="d-block fw-semibold">Lead Status</span>
                            <span class="badge bg-label-primary mt-1">@Model.Status?.StatusName</span>
                        </div>
                        <div class="col-6 mb-3">
                            <span class="d-block fw-semibold">Source</span>
                            <span class="badge bg-label-warning mt-1">@(Model.Source?.Title ?? "N/A")</span>
                        </div>
                        <div class="col-6">
                            <span class="d-block fw-semibold">Industry</span>
                            <span>@(Model.IndustryName ?? "-")</span>
                        </div>
                        <div class="col-6">
                            <span class="d-block fw-semibold">Created On</span>
                            <span>@Model.CreatedOn.ToString("dd MMM yyyy")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <h5 class="card-header border-bottom">Activity History</h5>
                <div class="card-body pt-4">
                    @if (Model.FollowUps != null && Model.FollowUps.Any())
                    {
                        <ul class="timeline">
                            @foreach (var item in Model.FollowUps)
                            {
                                <li class="timeline-item timeline-item-transparent pb-4 border-bottom">
                                    <span class="timeline-point timeline-point-primary"></span>
                                    <div class="timeline-event">

                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="badge bg-label-secondary">
                                                <i class="bx bx-calendar me-1"></i> @item.FollowUpDate.ToString("dd MMM yyyy, hh:mm tt")
                                            </span>

                                            <a href="@Url.Action("DeleteActivity", "Leads", new { id = item.Id })"
                                               class="text-danger ms-2"
                                               onclick="return confirm('Are you sure you want to delete this activity?');">
                                                <i class="bx bx-trash"></i>
                                            </a>    
                                        </div>

                                        <div class="mb-3">
                                            <p class="mb-0 text-dark fs-6">@item.Remarks</p>
                                        </div>

                                        <div class="d-flex flex-wrap align-items-center gap-3 p-3 bg-lighter rounded">

                                            <div>
                                                <small class="text-muted d-block">Result / Status</small>
                                                <span class="fw-bold text-primary">
                                                    @item.FollowUpStatus?.StatusName
                                                    @if (!string.IsNullOrEmpty(item.Response))
                                                    {
                                                        <span> - @item.Response</span>
                                                    }
                                                </span>
                                            </div>

                                            <div class="vr"></div>

                                            <div>
                                                <small class="text-muted d-block">Next Follow-up</small>
                                                @if (item.NextFollowUpDate.HasValue)
                                                {
                                                    <span class="fs-5 fw-bold text-warning">
                                                        <i class="bx bx-time-five me-1"></i> @item.NextFollowUpDate.Value.ToString("dd MMM yyyy")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </div>

                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <h4 class="text-muted">No history yet!</h4>
                            <p>Click "Add Activity" to start logging conversations.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="followUpModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Log Activity</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddFollowUp" method="POST" novalidate id="followUpForm">
                <div class="modal-body">
                    <input type="hidden" name="leadId" value="@Model.Id" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Follow-up Date</label>
                            <input type="datetime-local" name="followUpDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Type <span class="text-danger">*</span></label>
                            <select name="followUpTypeId" id="ddlType" class="form-select" asp-items="ViewBag.FollowUpTypes">
                                <option value="">-- Select Type --</option>
                            </select>
                            <div class="invalid-feedback">
                                Please select a Follow-up Type.
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Status <span class="text-danger">*</span></label>
                            <select name="followUpStatusId" id="ddlStatus" class="form-select" asp-items="ViewBag.FollowUpStatuses">
                                <option value="">-- Select Status --</option>
                            </select>
                            <div class="invalid-feedback">
                                Please select the Status.
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Short Response</label>
                            <input type="text" name="response" class="form-control" placeholder="e.g. Positive, Switch Off" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 mb-3">
                            <label class="form-label">Remarks <span class="text-danger">*</span></label>
                            <textarea name="remarks" id="txtRemarks" class="form-control" rows="3" placeholder="Detailed conversation notes..."></textarea>
                            <div class="invalid-feedback">
                                Please enter some remarks.
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 mb-3">
                            <label class="form-label">Next Follow-up Date</label>
                            <input type="datetime-local" name="nextFollowUpDate" class="form-control" />
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary" onclick="submitFollowUp()">Save Activity</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteFollowUpModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete Activity?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this activity record?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <a href="#" id="btnConfirmDeleteFollowUp" class="btn btn-danger">Yes, Delete</a>
            </div>
        </div>
    </div>
</div>

<script>
    function submitFollowUp() {
     
        var typeDropdown = document.getElementById("ddlType");
        var statusDropdown = document.getElementById("ddlStatus");
        var remarksBox = document.getElementById("txtRemarks"); 

        var isValid = true;

      

        
        if (typeDropdown.value === "" || typeDropdown.value === "0") {
            typeDropdown.classList.add("is-invalid");
            isValid = false;
        } else {
            typeDropdown.classList.remove("is-invalid"); 
        }

        
        if (statusDropdown.value === "" || statusDropdown.value === "0") {
            statusDropdown.classList.add("is-invalid");
            isValid = false;
        } else {
            statusDropdown.classList.remove("is-invalid");
        }

       
        if (remarksBox.value.trim() === "") {
            remarksBox.classList.add("is-invalid");
            isValid = false;
        } else {
            remarksBox.classList.remove("is-invalid");
        }

        
        if (isValid) {
            document.getElementById("followUpForm").submit();
        }
    }
</script>