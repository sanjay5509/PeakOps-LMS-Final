@model IEnumerable<PeakOps.Core.Entities.Permission>

<div class="card">
    <div class="card-header d-flex justify-content-between">
        <h5>Permission Master List</h5>
        <a asp-action="Create" class="btn btn-primary">Add New Key</a>
    </div>
    <div class="card-body">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Permission Key (For Code)</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.PermissionName</td>
                        <td><code>@item.PermissionKey</code></td>
                        <td>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Pakka delete karna hai?')">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>