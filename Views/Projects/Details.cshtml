@model PeakOps.Core.Entities.Project

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1">@Model.ProjectName</h4>
            <span class="badge bg-label-success">@Model.Status</span>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>

    <div class="nav-align-top mb-4">
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item">
                <button type="button" class="nav-link active" role="tab" data-bs-toggle="tab" data-bs-target="#navs-overview">
                    <i class="bx bx-home me-1"></i> Overview
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-team">
                    <i class="bx bx-group me-1"></i> Team (@Model.Assignments.Count)
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-vault">
                    <i class="bx bx-lock-alt me-1"></i> Credentials Vault
                </button>
            </li>
        </ul>

        <div class="tab-content">

            <div class="tab-pane fade show active" id="navs-overview" role="tabpanel">
                <div class="row">
                    <div class="col-md-6">
                        <h5>Description</h5>
                        <p>@Model.ProjectDescription</p>
                    </div>
                    <div class="col-md-6">
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item"><strong>Start Date:</strong> @(Model.StartDate?.ToString("dd MMM yyyy") ?? "-")</li>
                            <li class="list-group-item"><strong>Target Date:</strong> @(Model.TargetDate?.ToString("dd MMM yyyy") ?? "-")</li>
                            <li class="list-group-item"><strong>Created On:</strong> @Model.CreatedOn.ToString("dd MMM yyyy")</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="navs-team" role="tabpanel">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="card-title m-0">Project Team</h5>
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addMemberModal">
                        <i class="bx bx-plus me-1"></i> Add Member
                    </button>
                </div>

                <div class="table-responsive text-nowrap">
                    <table class="table table-bordered table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>User</th>
                                <th>Role</th>
                                <th style="width: 100px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Assignments.Any())
                            {
                                @foreach (var assign in Model.Assignments)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar avatar-xs me-2">
                                                    <span class="avatar-initial rounded-circle bg-label-primary">
                                                        @assign.User.FirstName.Substring(0, 1)
                                                    </span>
                                                </div>
                                                @assign.User.FirstName @assign.User.LastName
                                            </div>
                                        </td>
                                        <td><span class="badge bg-label-info">@assign.ProjectRole.RoleName</span></td>
                                        <td>
                                            <a asp-action="RemoveAssignment" asp-route-id="@assign.Id" class="btn btn-icon btn-sm text-danger" onclick="return confirm('Remove this member?');">
                                                <i class="bx bx-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="3" class="text-center text-muted">No team members assigned.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-pane fade" id="navs-vault" role="tabpanel">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="card-title m-0">Credentials Vault</h5>
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addCredentialModal">
                        <i class="bx bx-plus me-1"></i> Add Credential
                    </button>
                </div>

                <div class="table-responsive text-nowrap">
                    <table class="table table-bordered table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Title / URL</th>
                                <th>Username</th>
                                <th>Password</th>
                                <th style="width: 100px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Credentials.Any())
                            {
                                @foreach (var cred in Model.Credentials)
                                {
                                    <tr>
                                        <td>
                                            <strong>@cred.Title</strong>
                                            @if (!string.IsNullOrEmpty(cred.Url))
                                            {
                                                <br />

                                                <a href="@cred.Url" target="_blank" class="small"><i class="bx bx-link-external"></i> Open Link</a>
                                            }
                                        </td>
                                        <td>
                                            @cred.Username
                                            <i class="bx bx-copy cursor-pointer text-primary ms-1" onclick="navigator.clipboard.writeText('@cred.Username')" title="Copy Username"></i>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <span class="me-2" id="pwd-text-@cred.Id">••••••••••••</span>
                                                <button class="btn btn-sm btn-icon btn-outline-secondary me-1" onclick="revealPassword(@cred.Id, this)">
                                                    <i class="bx bx-show"></i>
                                                </button>
                                                <button class="btn btn-sm btn-icon btn-outline-primary" onclick="copyToClipboard(@cred.Id)">
                                                    <i class="bx bx-copy"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td>
                                            <a href="javascript:void(0);" onclick="openDeleteModal('@cred.Id')" class="btn btn-icon btn-sm text-danger">
                                                <i class="bx bx-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="4" class="text-center text-muted">No credentials added yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="addMemberModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Assign Team Member</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddAssignment" method="post" class="needs-validation" novalidate>
                <div class="modal-body">
                    <input type="hidden" name="ProjectId" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label">Select User</label>
                        <select name="UserId" class="form-select" asp-items="ViewBag.Users" required>
                            <option value="">-- Choose User --</option>
                        </select>
                        <div class="invalid-feedback">Please select a user.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Assign Role</label>
                        <select name="ProjectRoleId" class="form-select" asp-items="ViewBag.Roles" required>
                            <option value="">-- Choose Role --</option>
                        </select>
                        <div class="invalid-feedback">Please select a role.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Member</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="addCredentialModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add New Credential</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddCredential" method="post" class="needs-validation" novalidate>
                <div class="modal-body">
                    <input type="hidden" name="ProjectId" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label">Title</label>
                        <input type="text" name="Title" class="form-control" placeholder="e.g. Server Admin, FTP, DB" required />
                        <div class="invalid-feedback">Title is required.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Login URL (Optional)</label>
                        <input type="text" name="Url" class="form-control" placeholder="https://..." />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Username</label>
                            <input type="text" name="Username" class="form-control" required />
                            <div class="invalid-feedback">Username required.</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Password</label>
                            <input type="text" name="PlainPassword" class="form-control" required />
                            <div class="invalid-feedback">Password required.</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Encrypt & Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteConfirmationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalCenterTitle">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this credential? This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <a href="#" id="btnConfirmDelete" class="btn btn-danger">Yes, Delete it</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
            
        (function () {
            'use strict'
            var forms = document.querySelectorAll('.needs-validation')
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }
                        form.classList.add('was-validated')
                    }, false)
                })
        })()

        
        function openDeleteModal(id) {
            var deleteUrl = '/Projects/DeleteCredential/' + id;
            var confirmButton = document.getElementById('btnConfirmDelete');
            confirmButton.href = deleteUrl;
            var myModal = new bootstrap.Modal(document.getElementById('deleteConfirmationModal'));
            myModal.show();
        }

       
        function revealPassword(id, btn) {
            fetch('/Projects/RevealPassword/' + id)
                .then(response => response.json())
                .then(data => {
                    var txtBox = document.getElementById('pwd-text-' + id);
                    if (txtBox.innerText.includes('•')) {
                        txtBox.innerText = data.password;
                        btn.innerHTML = '<i class="bx bx-hide"></i>';
                    } else {
                        txtBox.innerText = '••••••••••••';
                        btn.innerHTML = '<i class="bx bx-show"></i>';
                    }
                })
                .catch(error => console.error('Error:', error));
        }

       
        function copyToClipboard(id) {
            var txtBox = document.getElementById('pwd-text-' + id);
            if (txtBox.innerText.includes('•')) {
                Swal.fire({
                    icon: 'error',
                    title: 'Oops...',
                    text: 'Please reveal the password (eye icon) before copying!',
                    background: '#2b2c40',
                    color: '#fff',
                    confirmButtonColor: '#696cff'
                });
                return;
            }
            navigator.clipboard.writeText(txtBox.innerText);
            Swal.fire({
                icon: 'success',
                title: 'Copied!',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 2000,
                background: '#2b2c40',
                color: '#fff'
            });
        }
    </script>
}