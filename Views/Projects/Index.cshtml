@model IEnumerable<PeakOps.Core.Entities.Project>
@using PeakOps.Core.Services
@using System.Security.Claims
@inject PermissionService _permissionService

@{
    var userIdClaim = User.FindFirst(ClaimTypes.NameIdentifier);
    long currentUserId = 0;
    if (userIdClaim != null) { long.TryParse(userIdClaim.Value, out currentUserId); }
    bool isSuperAdmin = User.IsInRole("SuperAdmin");
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold py-3 mb-0">Projects Directory</h4>
        
        @if (isSuperAdmin || await _permissionService.HasPermission(currentUserId, "ADD_EDIT_PROJECT"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bx bx-plus"></i> New Project
            </a>
        }
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive text-nowrap">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Project Name</th>
                        <th>Status </th>
                        <th>Dates </th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-0">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@item.ProjectName</strong><br />
                                <small class="text-muted">Created: @item.CreatedOn.ToString("dd MMM yyyy")</small>
                            </td>
                            <td><span class="badge bg-label-primary me-1">@item.Status</span></td>
                            <td>
                                <small>Start: @(item.StartDate?.ToString("dd MMM") ?? "N/A")</small><br />
                                <small>Target: @(item.TargetDate?.ToString("dd MMM") ?? "N/A")</small>
                            </td>
                            <td>
                                <div class="d-inline-block text-nowrap">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-outline-info me-1" title="View Details">
                                        <i class="bx bx-show-alt"></i>
                                    </a>


                                   
                                    
                                    @if (isSuperAdmin || await _permissionService.HasPermission(currentUserId, "DELETE_PROJECT"))
                                    {
                                        <button type="button" class="btn btn-sm btn-icon btn-outline-danger" onclick="confirmDelete(@item.Id)" title="Delete">
                                            <i class="bx bx-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
